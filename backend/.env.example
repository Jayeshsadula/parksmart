# backend/.env.example
# Copy to .env and fill in your values

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Firebase Service Account ──────────────────────────────────────────────────
# Option A: path to local JSON file (development)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Option B: inline JSON string (cloud deployment / CI)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"parksmart-ai",...}

# ── Overtime Scanner ──────────────────────────────────────────────────────────
OVERTIME_SCAN_INTERVAL=300   # seconds between scans (300 = 5 minutes)

# ── Penalty Policy (INR) ─────────────────────────────────────────────────────
BUFFER_MINS=15
PENALTY_LOW=50
PENALTY_MEDIUM=100
PENALTY_HIGH=200
