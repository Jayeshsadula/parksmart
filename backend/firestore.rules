// firestore.rules
// ParkSmart AI — Firestore Security Rules
// Deploy: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isUser() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // ── Users collection ──────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isAuthenticated() && (isOwner(uid) || isAdmin());
      allow create: if isAuthenticated() && isOwner(uid);
      allow update: if isAuthenticated() && isOwner(uid);
      allow delete: if isAdmin();
    }

    // ── Admins collection ─────────────────────────────────────────────────
    match /admins/{uid} {
      allow read:   if isAuthenticated() && (isOwner(uid) || isAdmin());
      allow create: if isAuthenticated() && isOwner(uid);
      allow update: if isAuthenticated() && isOwner(uid);
      allow delete: if false; // Only via Firebase Console
    }

    // ── Parking areas ─────────────────────────────────────────────────────
    match /parking_areas/{areaId} {
      allow read:   if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Parking floors ────────────────────────────────────────────────────
    match /parking_floors/{floorId} {
      allow read:   if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Parking slots ─────────────────────────────────────────────────────
    match /parking_slots/{slotId} {
      allow read:   if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAuthenticated(); // Users can lock, admins can manage
      allow delete: if isAdmin();
    }

    // ── Bookings ──────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read:   if isAuthenticated() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Penalties ─────────────────────────────────────────────────────────
    match /penalties/{penaltyId} {
      allow read:   if isAuthenticated() &&
                       (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Notifications ─────────────────────────────────────────────────────
    match /notifications/{uid}/messages/{msgId} {
      allow read:   if isAuthenticated() && isOwner(uid);
      allow write:  if isAdmin();
    }

    // ── Live status (IoT sensor updates) ─────────────────────────────────
    match /live_status/{slotId} {
      allow read:   if isAuthenticated();
      allow write:  if isAdmin(); // ESP32 uses admin SDK server-side
    }

    // ── Analytics (admin only) ────────────────────────────────────────────
    match /analytics/{docId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }
  }
}
